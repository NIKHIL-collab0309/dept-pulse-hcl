# Prototype demo passwords (shown in the login screen's "Prototype Demo Accounts"
# helper for academic reviewers). Each must hash to the digest above.
# DELETE this table from any real deployment's secrets.
# -----------------------------------------------------------------------------
[demo_accounts]
