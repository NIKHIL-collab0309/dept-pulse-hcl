# -----------------------------------------------------------------------------
# Department-wise Performance Analysis — credentials template
# -----------------------------------------------------------------------------
# Copy this file to .streamlit/secrets.toml (git-ignored) for local runs, or paste
# the [users] section into "App settings -> Secrets" on Streamlit Community Cloud.
#
# Passwords are stored ONLY as lowercase hex SHA-256 digests. Generate a new one:
#   python -c "import hashlib; print(hashlib.sha256('NewPassword'.encode()).hexdigest())"
#
# role           : "Dean" or "HOD"
# programme_code : "ALL" for Dean; one of BTECH | MCA | BCA | MBA for an HOD
#
# When .streamlit/secrets.toml is absent, the app and the test suite read the
# [users] table from THIS file as a fallback, so the demo works out of the box.
# Change every password before any shared or public deployment.
# -----------------------------------------------------------------------------

[users.dean_academics]
password_sha256 = "3f8812cfe522b85a02948f6bfbce754ada7d1ed31b5f5479cdeaad020a13a618"
role = "Dean"
programme_code = "ALL"
display_name = "Dean of Academics"

[users.hod_btech]
password_sha256 = "f53eb6e95e417eb4dfd5919077abbc0735a65d7f3327f379bcc2a8f1b76c8b68"
role = "HOD"
programme_code = "BTECH"
display_name = "HOD, B.Tech"

[users.hod_mca]
password_sha256 = "188a6ac0cbee345a7bc50269febb5b9efc5c4523cc546c77f06235d9974cad4a"
role = "HOD"
programme_code = "MCA"
display_name = "HOD, MCA"

[users.hod_bca]
password_sha256 = "c32458a43dd14ce17867534ee705e1b585dd5ef0b9071a2b6d8b360b65e66107"
role = "HOD"
programme_code = "BCA"
display_name = "HOD, BCA"

[users.hod_mba]
password_sha256 = "c8d783cc25580bb561651b8836b38f055ef09a9c1620ba4b4a6bc12b4cbf89c1"
role = "HOD"
programme_code = "MBA"
display_name = "HOD, MBA"

